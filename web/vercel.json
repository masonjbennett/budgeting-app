{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api" }],
  "functions": {
    "api/index.py": {
      "excludeFiles": "{node_modules/**,.next/**,**/test_*.py,**/*.test.py}",
      "maxDuration": 60
    }
  }
}
